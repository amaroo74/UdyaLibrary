APP_NAME=Udaya Library Dataset System
DATABASE_URL=sqlite:///./data/udaya_library.db
# Required on every startup. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Required only for the first startup when the database contains no users.
# Set these in backend/.env, provision once, then remove INITIAL_ADMIN_PASSWORD.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Optional Google Books API key. Adds quota/authentication support when configured.
GOOGLE_BOOKS_API_KEY=

# Optional Google Custom Search Book Discovery Engine
# If left empty, system operates in local offline mode using open fallback sources.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
